; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="MoneyMaker"
config/description="Ton salaire tombe dans un bocal, tes pauses sentent le beurre chaud."
config/version="2.0.0-proto"
run/main_scene="res://scenes/home/home.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Events="*res://services/events.gd"
Clock="*res://services/clock.gd"
Game="*res://services/game.gd"
WindowModes="*res://services/window_modes.gd"
Atmosphere="*res://services/atmosphere.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/per_pixel_transparency/allowed=true

[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/sleep_velocity_threshold=0.25
jolt_physics_3d/simulation/sleep_time_threshold=0.4
3d/default_gravity=40.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.16, 0.13, 0.19, 1)

[threading]

worker_pool/max_threads=2
